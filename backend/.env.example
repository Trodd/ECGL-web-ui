DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
SESSION_SECRET=your_session_secret

# Discord bot settings
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_guild_id
DISCORD_INVITE_URL=https://discord.gg/your_invite
DISCORD_LEAGUE_MOD_ROLE_ID=your_league_mod_role_id

DISCORD_PLAYER_ROLE_ID=your_player_role_id
DISCORD_LEAGUE_SUB_ROLE_ID=your_league_sub_role_id
DISCORD_CAPTAIN_ROLE_ID=your_captain_role_id
DISCORD_CO_CAPTAIN_ROLE_ID=your_co_captain_role_id

MATCH_CHANNEL_CATEGORY_ID=your_match_channel_category_id
DISCORD_LOG_CHANNEL_GENERAL=your_general_log_channel_id
DISCORD_LOG_CHANNEL_MATCHES=your_matches_log_channel_id
DISCORD_LOG_CHANNEL_SCORES=your_scores_log_channel_id
SUB_PING_CHANNEL_ID=your_sub_ping_channel_id
DISCORD_TRANSCRIPT_CHANNEL_ID=your_transcript_channel_id

# caster role and category
DISCORD_CASTER_ROLE_ID=your_caster_role_id
DISCORD_CAST_CATEGORY_ID=your_cast_category_id

# Frontend URLs
TLS_HOST=ecgleague.com
FRONTEND_URL=https://ecgleague.com   # prod
FRONTEND_URL_DEV=http://localhost:5173

# discord oauth redirect
OAUTH_REDIRECT=https://ecgleague.com/callback

# calendar settings
SEASON_START=2026-01-13
SEASON_END=2026-04-06
# break weeks (comma-separated start:end pairs, e.g. 2026-02-09:2026-02-15,2026-03-16:2026-03-22)
BREAKS=2026-02-09:2026-02-15
# finals periods (comma-separated start:end pairs, e.g. 2026-04-13:2026-04-20,2026-04-27:2026-05-04)
FINALS=2026-04-13:2026-04-20

# league settings
WEEKLY_CHALLENGE_LIMIT=1
ELO_WIN_POINTS=50
ELO_LOSS_POINTS=-25
UNDERDOG_BONUS_PER_100=10
UNDERDOG_LOSS_REDUCTION_PER_100=5
CHALLENGE_BONUS_MULTIPLIER=2
MAX_RATING=1300
MIN_RATING=0
DEFAULT_PLAYER_RATING=800
DEFAULT_TEAM_RATING=800
MIN_TEAM_PLAYERS=3
MAX_TEAM_PLAYERS=5
CURRENT_SEASON=1

# dev mode lets admins fully impersonate another user's login (reads AND writes)
# via the Dev Toolbar in the UI. Make sure to set false for production!
DEV_MODE=false